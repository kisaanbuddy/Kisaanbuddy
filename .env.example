# ===========================================================================
# KISAANBUDDY BACKEND V2 — ENVIRONMENT VARIABLE CONFIGURATION TEMPLATE
# ===========================================================================
# DO NOT COMMIT ACTUAL SECRETS OR REAL CREDENTIALS TO GIT.

# --- Application Core ---
PROJECT_NAME="KrishiAI API"
DEBUG=false
ENVIRONMENT="production" # options: development, staging, production

# --- Authentication & JWT Security ---
# Mandatory in production: generate a 64-character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET="YOUR_SECURE_RANDOM_JWT_SECRET_KEY_HERE"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration ---
# Mandatory in production: PostgreSQL connection URI
DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/kisaanbuddy_prod"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Redis & Shared State ---
# Required for distributed multi-instance deployment and async queues
REDIS_URL="redis://default:password@localhost:6379/0"

# --- Object Storage (S3 / R2) ---
STORAGE_PROVIDER="s3" # options: local, s3
S3_BUCKET_NAME="kisaanbuddy-production-media"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION="ap-south-1"

# --- SMS & OTP Provider (2Factor) ---
OTP_PROVIDER="2factor"
TWOFACTOR_API_KEY="YOUR_2FACTOR_API_KEY_HERE"

# --- AI & Agronomy LLM Services ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
SARVAM_API_KEY="YOUR_SARVAM_TTS_API_KEY_HERE"

# --- Hardware IoT Sensor Security ---
SENSOR_INGEST_TOKEN="YOUR_SECURE_ESP32_INGEST_TOKEN_HERE"

# --- Admin & Owner Security ---
ADMIN_EMAILS="admin@kisaanbuddy.com,aditya@kisaanbuddy.com,utkarsh@kisaanbuddy.com,yash@kisaanbuddy.com"
