# Database
DATABASE_URL=sqlite:///./krishiai.db
# DATABASE_URL=postgresql://user:password@host:5432/krishiai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_48_byte_random_secret
# Set false in every deployed environment. The API refuses an unset/placeholder
# JWT secret when DEBUG=false.
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional, only if a specific Vercel preview pattern is owned and trusted.
ALLOWED_ORIGIN_REGEX=
GOOGLE_CLIENT_ID=

# AI/LLM
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# Weather
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=

# Mandi
DATA_GOV_API_KEY=

# OTP
OTP_PROVIDER=console
TWOFACTOR_API_KEY=

# Supabase (optional - for disease image storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (optional)
REDIS_URL=

# WhatsApp Business Platform Cloud API
# Acquire credentials from Meta for Developers -> WhatsApp App -> API Setup
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_APP_ID=your_meta_app_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEST_RECIPIENT=+919876543210
WHATSAPP_SIGNATURE_VERIFICATION=true
WHATSAPP_MONTHLY_BUDGET_INR=5000.0
FRONTEND_BASE_URL=http://localhost:3000
