# Database
DATABASE_URL=sqlite:///./krishiai.db
# DATABASE_URL=postgresql://user:password@host:5432/krishiai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_48_byte_random_secret
# Set false in every deployed environment. The API refuses an unset/placeholder
# JWT secret when DEBUG=false.
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional, only if a specific Vercel preview pattern is owned and trusted.
ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
GOOGLE_CLIENT_ID=

# AI/LLM
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# Weather
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=

# Mandi
DATA_GOV_API_KEY=

# OTP & Phone Verification
# Options: console (dev/test), 2factor (production), msg91, twilio
OTP_PROVIDER=console
TWOFACTOR_API_KEY=

# Crop Doctor ML Engine & Supervised Field Pilot
CROP_DOCTOR_MODEL_PATH=ml/crop_doctor/artifacts/experiments/exp_c2_efficientnet_b0_pretrained_224/best_model.pth
CROP_DOCTOR_DEVICE=cpu
CROP_DOCTOR_CONFIDENCE_THRESHOLD=0.60
CROP_DOCTOR_TEMPERATURE=1.0500
RATE_LIMIT_PER_MINUTE=60

# Pilot Image Storage Configuration
# Options: local (development), mounted (persistent volume in staging/docker), s3, supabase
STORAGE_BACKEND=local
PILOT_STORAGE_PATH=uploads/pilot_images
# Optional S3-compatible cloud object storage (AWS S3, Cloudflare R2, MinIO, Supabase S3)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Supabase (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (optional)
REDIS_URL=
