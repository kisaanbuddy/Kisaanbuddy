# Database
DATABASE_URL=sqlite:///./krishiai.db
# DATABASE_URL=postgresql://user:password@host:5432/krishiai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_48_byte_random_secret
# Set false in every deployed environment. The API refuses an unset/placeholder
# JWT secret when DEBUG=false.
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional, only if a specific Vercel preview pattern is owned and trusted.
ALLOWED_ORIGIN_REGEX=
GOOGLE_CLIENT_ID=

# AI/LLM
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# Weather
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=

# Mandi
DATA_GOV_API_KEY=

# OTP
OTP_PROVIDER=console
TWOFACTOR_API_KEY=

# Supabase (optional - for disease image storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (optional)
REDIS_URL=
